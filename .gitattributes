# Normalize line endings: LF in repo and in working trees (all platforms).
# Content tests read source files with fs.readFileSync and assert multi-line
# strings containing "\n" — CRLF checkouts break them.
* text=auto eol=lf

# Windows scripts conventionally keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.keystore binary
*.jks binary
