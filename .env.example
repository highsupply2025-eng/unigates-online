# Backend (Lovable Cloud) — publishable values, safe in the browser bundle
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Payments (Paddle) client-side token — publishable, environment specific.
# .env.development holds the test token (test_...), .env.production the live token (live_...).
# Never put a Paddle API key or webhook signing secret in an env file: those are
# server-side secrets and live in the backend secret store only.
VITE_PAYMENTS_CLIENT_TOKEN="live_xxxxxxxxxxxxxxxxxxxxxxxx"

# Server-side secrets (backend secret store, NOT committed):
#   PADDLE_LIVE_API_KEY
#   PADDLE_SANDBOX_API_KEY
#   PADDLE_LIVE_WEBHOOK_SECRET
#   PADDLE_SANDBOX_WEBHOOK_SECRET
